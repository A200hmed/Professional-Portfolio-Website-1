# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Admin Credentials ─────────────────────────────────────
ADMIN_USER=your_admin_username
ADMIN_PASS=your_strong_password_here
ADMIN_TOKEN_SECRET=your_very_long_random_secret_token_here

# ── MongoDB ───────────────────────────────────────────────
# Get your free URI from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ── Email Settings (Nodemailer) ──────────────────────────
# For Gmail: Use App Passwords (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_TO=recipient_email@gmail.com
